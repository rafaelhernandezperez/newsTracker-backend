# Hugging Face Inference Providers token — powers AI summary/importance/sentiment.
# Create at https://huggingface.co/settings/tokens with "Make calls to Inference Providers".
HF_TOKEN=

# Optional model override (default: meta-llama/Llama-3.3-70B-Instruct)
# HF_MODEL=

# Finnhub (https://finnhub.io — free tier) enables historical dated company news
# for the chart markers. Without it, history comes from Google News date windows only.
FINNHUB_TOKEN=

# Comma-separated browser origins allowed to call the API. Leave unset to use
# the built-in list (Firebase Hosting domains + localhost:4200 for `ng serve`).
# Set this when deploying the frontend to a new domain: an origin that is not
# listed is refused by CORS.
# ALLOWED_ORIGINS=https://financialnewstracker.web.app,http://localhost:4200

# How many X-Forwarded-For hops are trusted infrastructure, used to derive the
# client IP for rate limiting. 1 is correct on Cloud Functions v2. Raise to 2
# only if deployed behind an extra load balancer (symptom: every caller shares
# one rate-limit bucket because req.ip is a Google address).
# TRUST_PROXY_HOPS=1
